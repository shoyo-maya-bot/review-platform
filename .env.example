# docker compose 用. このファイルを .env にコピーして値を入れる（.env はコミットしない）.

# API トークンの SHA-256（`docker compose run --rm --no-deps api token` か `review-platform token` で作る）
RP_API_TOKENS_SHA256=<your-value>

# LLM. fake（試験用の決まった返事）/ none（変換だけ）/ anthropic（API キーが要る）
RP_LLM=fake
# RP_LLM=anthropic
# ANTHROPIC_API_KEY=<your-value>
# RP_LLM_BASE_URL=https://api.anthropic.com

# 費用の上限（USD）. 既定は 0 で、0 は「有料の LLM（anthropic・bedrock）を一切呼ばない」. 疑似 LLM（fake）は無料なので 0 のままで動く.
# 有料の LLM を使うときだけ、3 つとも 0 より大きい値を入れる（1 つでも 0 なら呼ばない）
RP_BUDGET_PER_JOB_USD=0
RP_BUDGET_DAILY_USD=0
RP_BUDGET_DAILY_PER_OWNER_USD=0
# 例: RP_BUDGET_PER_JOB_USD=1  RP_BUDGET_DAILY_USD=10  RP_BUDGET_DAILY_PER_OWNER_USD=2
