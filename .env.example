# docker compose 用. このファイルを .env にコピーして値を入れる（.env はコミットしない）.

# API トークンの SHA-256（`docker compose run --rm --no-deps api token` か `review-platform token` で作る）
RP_API_TOKENS_SHA256=<your-value>

# LLM. fake（試験用の決まった返事）/ none（変換だけ）/ anthropic（API キーが要る）
RP_LLM=fake
# RP_LLM=anthropic
# ANTHROPIC_API_KEY=<your-value>
# RP_LLM_BASE_URL=https://api.anthropic.com
